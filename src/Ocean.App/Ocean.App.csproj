<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Ocean.App</RootNamespace>
    <AssemblyName>Ocean</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\ocean.ico</ApplicationIcon>
    <StartupObject>Ocean.App.App</StartupObject>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- the recording's sound reads the audio devices' buffers directly -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Per-monitor DPI is declared in app.manifest for WPF; the WinForms analyzer only covers the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray NotifyIcon; keep its namespaces out of the implicit usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\ocean.ico" Link="Assets\ocean.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ocean.Core\Ocean.Core.csproj" />
  </ItemGroup>
</Project>

<Window x:Class="Ocean.App.Views.RecordBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocean: recording your screen" SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}" Foreground="White">
    <!-- "Recording" (DataContext: RecordViewModel). Kept out of every capture, so it is never in the recording itself. -->
    <Border Background="#F21A0F14" BorderBrush="#E11D48" BorderThickness="1.5" CornerRadius="9" Padding="12,6,6,6" Margin="6" Cursor="SizeAll">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FB7185" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Foreground="#FB7185" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" MinWidth="44"/>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="#FBCFD6">
                <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SoundText, Mode=OneWay}"/>
            </TextBlock>
            <!-- the microphone: mute and unmute while recording -->
            <Button Width="32" Height="28" Margin="12,0,0,0" Command="{Binding ToggleMicCommand}" ToolTip="{Binding MicTip}" Cursor="Hand"
                    Visibility="{Binding HasMic, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Mute the microphone">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                        <Setter Property="Content" Value="&#xE720;"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                <Setter Property="Content" Value="&#xF781;"/>
                                <Setter Property="Foreground" Value="#FB7185"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Margin="8,0,0,0" Command="{Binding StopCommand}" Background="#E11D48" BorderBrush="#E11D48" Foreground="White" FontWeight="SemiBold" Cursor="Hand"
                    AutomationProperties.Name="Stop recording">
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" Background="White" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Stop" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>

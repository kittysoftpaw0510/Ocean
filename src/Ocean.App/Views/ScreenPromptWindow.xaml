<Window x:Class="Ocean.App.Views.ScreenPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocean: screen request" Width="380" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <!-- A question from another PC (DataContext: ScreenPromptVm). Never answers itself: it waits, then times out as "no". -->
    <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="10" Padding="16,14,16,14" Margin="6">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeLeft}" Style="{StaticResource Dim}" VerticalAlignment="Top" ToolTip="Without an answer, the request is declined"/>
                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{Binding Dto.PeerId, Converter={StaticResource InitialsBrush}}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="15" Foreground="#0A1120" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource BtnGhost}" Content="Don't ask again" Click="Mute_Click" Padding="6,5" FontSize="12"
                        ToolTip="Decline, and don't show this PC's screen requests any more (you can allow them again from its right-click menu)"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Decline" Click="Decline_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="{Binding AllowLabel}" Click="Allow_Click" MinWidth="80"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

<UserControl x:Class="Ocean.App.Views.SharesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Ocean.App.Controls"
             AllowDrop="True">
    <UserControl.Resources>
        <!-- a video in my share (drag it onto a folder to organize) -->
        <DataTemplate x:Key="LocalItemRow">
            <Border x:Name="Row" Margin="12,1" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Move to…" Click="MoveTo_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE8DE;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Who can open this video" IsEnabled="False"/>
                        <MenuItem Header="Same as share" Tag="Inherit" Click="Policy_Click"/>
                        <MenuItem Header="Everyone" Tag="Public" Click="Policy_Click"/>
                        <MenuItem Header="Password…" Tag="Password" Click="Policy_Click"/>
                        <MenuItem Header="Ask me each time" Tag="Ask" Click="Policy_Click"/>
                        <Separator/>
                        <MenuItem Header="Show in Explorer" Click="Reveal_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="80" Height="45">
                        <Rectangle RadiusX="6" RadiusY="6" Fill="{StaticResource Bg3}"/>
                        <Rectangle RadiusX="6" RadiusY="6">
                            <Rectangle.Fill><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Dim}">
                            <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text="{Binding DurationText, Mode=OneWay, StringFormat='  ·  {0}'}"/><Run Text="{Binding AddedText, Mode=OneWay, StringFormat='  ·  added {0}'}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="10" Background="{StaticResource Bg3}" Padding="8,2" VerticalAlignment="Center" Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PolicyGlyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Warn}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PolicyText}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Content="&#xE712;" ToolTip="Options" Margin="6,0,0,0" Click="RowMenu_Click" AutomationProperties.Name="Options"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Bg2}"/></Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Bg3}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a folder in my share: double-click to open, drop videos onto it -->
        <DataTemplate x:Key="LocalFolderRow">
            <Border x:Name="Row" Margin="12,1" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"
                    AllowDrop="True" DragOver="Folder_DragOver" DragLeave="Folder_DragLeave" Drop="Folder_Drop">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="FolderOpen_Click"/>
                        <MenuItem Header="Rename…" Click="FolderRename_Click"/>
                        <Separator/>
                        <MenuItem Header="Remove folder (videos move up)" Click="FolderDelete_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="80" Height="45">
                        <Rectangle RadiusX="6" RadiusY="6" Fill="{StaticResource Bg3}"/>
                        <Rectangle RadiusX="6" RadiusY="6" Opacity="0.4">
                            <Rectangle.Fill><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Accent}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnIcon}" Content="&#xE8AC;" ToolTip="Rename" Click="FolderRename_Click" AutomationProperties.Name="Rename folder"/>
                        <Button Style="{StaticResource BtnIcon}" Content="&#xE76C;" ToolTip="Open" Click="FolderOpen_Click" AutomationProperties.Name="Open folder"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Bg2}"/></Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Bg3}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ShareItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ left: my shares ============ -->
        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="My shares" Style="{StaticResource H1}" Margin="24,20,24,4"/>
                <WrapPanel Grid.Row="1" Margin="22,6,14,6">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddFolderCommand}" Margin="0,0,8,6" ToolTip="Share a folder from your disk (its sub-folders come along)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Share a folder" Foreground="{StaticResource AccentText}"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,6" Command="{Binding AddFilesCommand}" ToolTip="Share individual video files">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Files"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,6" Command="{Binding NewTopFolderCommand}" ToolTip="Create an empty folder here and add videos to it later">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="New folder"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Shares}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource ShareItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" AllowDrop="True" DragOver="ShareItem_DragOver" Drop="ShareItem_Drop">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename…" Command="{Binding PlacementTarget.Tag.RenameShareCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Who can watch…" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Add videos…" Command="{Binding PlacementTarget.Tag.AddVideosCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Add a folder…" Command="{Binding PlacementTarget.Tag.AddFolderToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Rescan" Command="{Binding PlacementTarget.Tag.RescanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Open in Explorer" Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" IsEnabled="{Binding HasRoots}"/>
                                        <Separator/>
                                        <MenuItem Header="Remove…" Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.Tag><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/></Grid.Tag>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <TextBlock Text="{Binding ModeGlyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Dim}">
                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" videos  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ModeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="40" Height="3" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}" ToolTip="Scanning…"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Margin="22,10" Padding="18" CornerRadius="10" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1.5" VerticalAlignment="Top"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border"><Setter Property="Background" Value="Transparent"/></Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource TextDim}"/>
                        <TextBlock Text="Nothing shared yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="Drop folders or videos anywhere in this window, or use the buttons above. You decide who can watch: everyone, people with a password, or only those you approve." Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ right: selected share ============ -->
        <Grid Grid.Column="1" Visibility="{Binding Selected, Converter={StaticResource NullToVis}}" Background="Transparent"
              AllowDrop="True" DragOver="RightPane_DragOver" Drop="RightPane_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="24,20,24,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H1}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border CornerRadius="10" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Selected.ModeGlyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Selected.ModeText}" Foreground="{StaticResource Accent}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Selected.RootsShort}" Style="{StaticResource Dim}" ToolTip="{Binding Selected.RootsText}" VerticalAlignment="Center" MaxWidth="360"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Edit" Command="{Binding EditCommand}" CommandParameter="{Binding Selected}" ToolTip="Who can watch, password, shared folders"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Rename" Margin="6,0,0,0" Command="{Binding RenameShareCommand}" CommandParameter="{Binding Selected}"/>
                    <Button Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Command="{Binding RescanCommand}" CommandParameter="{Binding Selected}"
                            ToolTip="Look for added, changed or removed videos on disk" AutomationProperties.Name="Rescan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" c:Spin.IsSpinning="{Binding Selected.Scanning}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Rescan" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Content="Open folder" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding Selected}"
                            Visibility="{Binding Selected.HasRoots, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource BtnDanger}" Content="Remove" Margin="6,0,0,0" Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}"
                            ToolTip="Remove from My shares (files on disk are not deleted)"/>
                </StackPanel>
            </Grid>

            <!-- folder bar: where am I + organize actions -->
            <Grid Grid.Row="1" Margin="24,6,24,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnIcon}" Width="28" Height="28" FontSize="12" Content="&#xE74A;" ToolTip="Up one folder (Backspace)" Command="{Binding UpCommand}" Margin="0,0,6,0"
                            Visibility="{Binding CurrentFolder, Converter={StaticResource NullToVis}}" AutomationProperties.Name="Up one folder"/>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource TextMuted}" Margin="2,0,8,0" Visibility="{Binding FolderMode, Converter={StaticResource BoolToVis}}"/>
                    <!-- breadcrumb; each segment also accepts dropped videos -->
                    <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Seg" Style="{StaticResource BtnGhost}" Padding="6,3" Content="{Binding Name}" MaxWidth="200" ToolTip="{Binding Name}" Tag="{Binding Path}"
                                            AllowDrop="True" DragOver="Folder_DragOver" DragLeave="Folder_DragLeave" Drop="Crumb_Drop"
                                            Command="{Binding DataContext.GoToFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}"/>
                                    <TextBlock x:Name="Sep" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Foreground="{StaticResource TextDim}" Margin="2,0"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Seg" Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter TargetName="Seg" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Search results" Style="{StaticResource Muted}" Visibility="{Binding FolderMode, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnPrimary}" Margin="0,0,6,0" Command="{Binding MoveToCommand}" Visibility="{Binding SelectedItemCount, Converter={StaticResource CountToVis}}">
                        <TextBlock Foreground="{StaticResource AccentText}"><Run Text="Move "/><Run Text="{Binding SelectedItemCount, Mode=OneWay}"/><Run Text=" to…"/></TextBlock>
                    </Button>
                    <Button x:Name="AddButton" Style="{StaticResource BtnGhost}" Click="Add_Click" ToolTip="Add videos or a folder from your disk into the folder shown here">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Add videos"/>
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Video files…" Command="{Binding PlacementTarget.DataContext.AddVideosCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="A folder (with its sub-folders)…" Command="{Binding PlacementTarget.DataContext.AddFolderToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding NewFolderCommand}" Margin="4,0,0,0" ToolTip="Create a folder here to organize videos (your files on disk are not moved)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="New folder"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-6" Visibility="{Binding ItemsLoading, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <ListBox x:Name="ItemsList" Grid.Row="2" ItemsSource="{Binding Entries}" Margin="12,0,12,0" SelectionMode="Extended"
                     SelectionChanged="ItemsList_SelectionChanged" MouseDoubleClick="ItemsList_MouseDoubleClick" KeyDown="ItemsList_KeyDown"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown" PreviewMouseMove="ItemsList_PreviewMouseMove">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplateSelector>
                    <c:EntryTemplateSelector Item="{StaticResource LocalItemRow}" Folder="{StaticResource LocalFolderRow}"/>
                </ListBox.ItemTemplateSelector>
            </ListBox>
            <!-- empty folder: offer the next step -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVis}}">
                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="32" Foreground="{StaticResource TextDim}"/>
                <TextBlock Text="This folder is empty" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Add videos from your disk, drop files onto this window, or move videos here from another folder."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddVideosCommand}">
                        <TextBlock Text="Add videos…" Foreground="{StaticResource AccentText}"/>
                    </Button>
                    <Button Content="Add a folder…" Margin="8,0,0,0" Command="{Binding AddFolderToCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- grants -->

            <!-- grants -->
            <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,12" MaxHeight="220">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource H2}" Text="Who has access" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Dim}" Text="Nobody has unlocked a protected share or video yet. Grants appear here when someone enters a password or you approve a request." TextWrapping="Wrap"
                               Visibility="{Binding Grants.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Grants}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Revoke" Padding="8,2" FontSize="12"
                                            Command="{Binding DataContext.RevokeGrantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  →  "/><Run Text="{Binding What, Mode=OneWay}"/><Run Text="{Binding ExpiresText, Mode=OneWay, StringFormat='   ({0})'}" Foreground="{StaticResource TextDim}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="Ocean.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocean" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource BtnGhost}" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="AltButton" Style="{StaticResource BtnGhost}" Click="Alt_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource BtnPrimary}" Click="Ok_Click" Margin="8,0,0,0" IsDefault="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>

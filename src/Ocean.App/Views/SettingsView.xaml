<UserControl x:Class="Ocean.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Section caption above a card -->
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,22,0,8"/>
        </Style>
        <!-- A card that holds setting rows -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <!-- One row: title + description on the left, control on the right -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="18,14"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- "i" next to a setting's title: the full explanation, on hover -->
        <Style x:Key="InfoTip" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE946;"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,1,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Border}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- One readable column, aligned left like the other pages; the 1000* trick caps it at MaxWidth -->
            <Grid Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000*" MaxWidth="860"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,20,0,96">
                    <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                    <TextBlock Text="How this PC appears on the network, who can see it, and how videos are shared and downloaded." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <!-- ===================== Profile ===================== -->
                    <TextBlock Text="Profile" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Your name" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="What others see next to your shares." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="280" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="This PC's name" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Helps people tell your computers apart." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="280" Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================== Network ===================== -->
                    <TextBlock Text="Network" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Private group (shared secret)" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Empty: everyone on your network sees you. With a secret, only PCs that enter the same secret can see you and your shares. The secret never leaves this PC." AutomationProperties.HelpText="Empty: everyone on your network sees you. With a secret, only PCs that enter the same secret can see you and your shares. The secret never leaves this PC."/>
                                    </StackPanel>
                                    <TextBlock Text="Only PCs with the same secret see each other." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="200">
                                        <TextBox Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowSecret, Converter={StaticResource BoolToVis}}"/>
                                        <PasswordBox x:Name="SecretBox" Visibility="{Binding ShowSecret, Converter={StaticResource InvBoolToVis}}" PasswordChanged="SecretBox_PasswordChanged"/>
                                        <TextBlock Text="None (open network)" Style="{StaticResource Dim}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding Secret.Length, Converter={StaticResource ZeroToVis}}"/>
                                    </Grid>
                                    <Button Style="{StaticResource BtnIcon}" Content="&#xE7B3;" ToolTip="Show / hide" Margin="4,0,0,0" Click="ToggleSecret_Click"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="Generate" Padding="8,6" Command="{Binding GenerateSecretCommand}" ToolTip="Create a random secret to share with your group"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="Clear" Padding="8,6" Command="{Binding ClearSecretCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Upload speed limit" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Caps what this PC sends to others." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Minimum="0" Maximum="20480" TickFrequency="256" IsSnapToTickEnabled="True" Value="{Binding UploadLimitKBps}" Width="200" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UploadLimitText}" Width="76" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Keep offline nodes visible" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="When a PC goes offline, its last known shares stay listed (dimmed) for this long." AutomationProperties.HelpText="When a PC goes offline, its last known shares stay listed (dimmed) for this long."/>
                                    </StackPanel>
                                    <TextBlock Text="Offline PCs stay listed, dimmed, for this long." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding OfflineKeepHours, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="hours" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Allow connections on Public networks" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Windows marks many home and office networks as Public, and its firewall then stops other PCs from opening your shares. Turn this off on networks you don't trust, like a coffee shop's Wi-Fi." AutomationProperties.HelpText="Windows marks many home and office networks as Public, and its firewall then stops other PCs from opening your shares. Turn this off on networks you don't trust, like a coffee shop's Wi-Fi."/>
                                    </StackPanel>
                                    <TextBlock Text="Needed when Windows calls your network Public." Style="{StaticResource RowHint}"/>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,4,0,0" Visibility="{Binding FirewallManaged, Converter={StaticResource InvBoolToVis}}"
                                               Text="Ocean can't change the firewall here: reinstall it with the service option."/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AllowPublicNetworks}" AutomationProperties.Name="Allow connections on Public networks"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Let other PCs reach each other through this PC" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="When two PCs have no network path to each other but both reach this one, their videos pass through here (they see each other as 'via' this PC). That traffic counts against the upload limit above, and people watching go before downloads. Turn it off if this PC can't spare the bandwidth." AutomationProperties.HelpText="When two PCs have no network path to each other but both reach this one, their videos pass through here (they see each other as 'via' this PC). That traffic counts against the upload limit above, and people watching go before downloads. Turn it off if this PC can't spare the bandwidth."/>
                                    </StackPanel>
                                    <TextBlock Text="Passes videos between PCs that can&#x27;t reach each other." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AllowBridging}" AutomationProperties.Name="Let other PCs reach each other through this PC"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Networking" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Fast uses Windows' asynchronous network I/O. Compatibility works the way classic programs like IPmsg do and survives network add-ons (VPN, proxy, 'accelerator' and some security tools) that break the fast mode. Auto picks Compatibility when such an add-on is found or the fast mode has crashed on this PC. A change applies when the Ocean service restarts." AutomationProperties.HelpText="Fast uses Windows' asynchronous network I/O. Compatibility works the way classic programs like IPmsg do and survives network add-ons (VPN, proxy, 'accelerator' and some security tools) that break the fast mode. Auto picks Compatibility when such an add-on is found or the fast mode has crashed on this PC. A change applies when the Ocean service restarts."/>
                                    </StackPanel>
                                    <TextBlock Text="Auto suits almost every PC." Style="{StaticResource RowHint}"/>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,4,0,0" Text="{Binding NetworkInfo}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="220">
                                    <RadioButton Content="Auto (recommended)" Margin="0,2" IsChecked="{Binding NetworkMode, Converter={StaticResource Equals}, ConverterParameter=auto}"/>
                                    <RadioButton Content="Compatibility (classic)" Margin="0,2" IsChecked="{Binding NetworkMode, Converter={StaticResource Equals}, ConverterParameter=classic}"/>
                                    <RadioButton Content="Fast (asynchronous)" Margin="0,2" IsChecked="{Binding NetworkMode, Converter={StaticResource Equals}, ConverterParameter=fast}"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="Restart the service now" Padding="8,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Command="{Binding RestartServiceCommand}" ToolTip="Saves first; the service comes back within a few seconds"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================== Videos ===================== -->
                    <TextBlock Text="New videos" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Highlight videos as new" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Videos added since your last visit to a node are marked NEW, but never older than this." AutomationProperties.HelpText="Videos added since your last visit to a node are marked NEW, but never older than this."/>
                                    </StackPanel>
                                    <TextBlock Text="How long new videos keep their NEW mark." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding NewDays, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="days" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Notifications" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Tell me when someone adds videos." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding NotifyNewVideos}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================== Downloads ===================== -->
                    <TextBlock Text="Downloads" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Save downloads to" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Each node gets its own folder; the original folder structure is kept." AutomationProperties.HelpText="Each node gets its own folder; the original folder structure is kept."/>
                                    </StackPanel>
                                    <TextBlock Text="Each PC gets its own folder." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="240" Text="{Binding DownloadDir, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DownloadDir}"/>
                                    <Button Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseDownloadDirCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Parallel downloads" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="How many videos download at the same time." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxConcurrentDownloads}" Width="160" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MaxConcurrentDownloads}" Width="28" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Video cache" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Keeps what you watched from other PCs, so watching again, seeking back, or downloading it afterwards doesn't use the network again. The oldest videos make room. 0 turns it off." AutomationProperties.HelpText="Keeps what you watched from other PCs, so watching again, seeking back, or downloading it afterwards doesn't use the network again. The oldest videos make room. 0 turns it off."/>
                                    </StackPanel>
                                    <TextBlock Text="Makes watching again and seeking back instant. 0 = off." Style="{StaticResource RowHint}"/>
                                    <TextBlock Text="{Binding StreamCacheUsedText}" Style="{StaticResource RowHint}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding StreamCacheGB, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalContentAlignment="Center"
                                             AutomationProperties.Name="Video cache size in GB"/>
                                    <TextBlock Text="GB" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,12,0"/>
                                    <Button Style="{StaticResource BtnGhost}" Content="Clear" Padding="8,6" Command="{Binding ClearStreamCacheCommand}"
                                            ToolTip="Delete the cached video bytes now"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Make lighter copies of my videos for watching" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="When someone has been watching one of your heavy videos for half a minute, this PC makes a 720p copy at about 1.5 Mbps and serves that to viewers from then on: the same picture for screen recordings, a fraction of the network. Your original file is never touched, and downloads always get the original. Made one at a time at low priority; viewers see 'Preparing…' meanwhile." AutomationProperties.HelpText="When someone has been watching one of your heavy videos for half a minute, this PC makes a 720p copy at about 1.5 Mbps and serves that to viewers from then on: the same picture for screen recordings, a fraction of the network. Your original file is never touched, and downloads always get the original. Made one at a time at low priority; viewers see 'Preparing…' meanwhile."/>
                                    </StackPanel>
                                    <TextBlock Text="720p copies of heavy videos, made when someone watches." Style="{StaticResource RowHint}"/>
                                    <TextBlock Text="{Binding LightStatusText}" Style="{StaticResource RowHint}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding LightCopies}" IsEnabled="{Binding LightAvailable}" AutomationProperties.Name="Make lighter copies of my videos for watching"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}" IsEnabled="{Binding LightCopies}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Keep lighter copies" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="A copy is deleted this many days after it was last watched, and when the original changes or leaves the share. The disk limit removes the least recently watched copies first." AutomationProperties.HelpText="A copy is deleted this many days after it was last watched, and when the original changes or leaves the share. The disk limit removes the least recently watched copies first."/>
                                    </StackPanel>
                                    <TextBlock Text="Days after the last viewing, and a disk limit." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding LightKeepDays, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalContentAlignment="Center" AutomationProperties.Name="Days to keep lighter copies"/>
                                    <TextBlock Text="days" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,18,0"/>
                                    <TextBox Text="{Binding LightCacheGB, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalContentAlignment="Center" AutomationProperties.Name="Disk space for lighter copies in GB"/>
                                    <TextBlock Text="GB at most" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Maximum CPU for Ocean" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Sharing, bridging and making lighter copies together never use more than this share of the PC's processor; Windows enforces it. Lighter copies get two thirds of it, so people watching always keep a share. The player in this app is not limited. 100 = no limit." AutomationProperties.HelpText="Sharing, bridging and making lighter copies together never use more than this share of the PC's processor; Windows enforces it. Lighter copies get two thirds of it, so people watching always keep a share. The player in this app is not limited. 100 = no limit."/>
                                    </StackPanel>
                                    <TextBlock Text="Ocean's background work never goes above this." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding CpuLimitPercent, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalContentAlignment="Center" AutomationProperties.Name="Maximum CPU for Ocean in percent"/>
                                    <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================== App ===================== -->
                    <TextBlock Text="App" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Group}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open Ocean when I sign in" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Starts minimized in the system tray. Sharing itself runs as a service either way." AutomationProperties.HelpText="Starts minimized in the system tray. Sharing itself runs as a service either way."/>
                                </StackPanel>
                                <TextBlock Text="Starts minimized in the tray." Style="{StaticResource RowHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding RunAtStartup}"/>
                        </Grid>
                    </Border>

                    <!-- ===================== About ===================== -->
                    <TextBlock Text="About this node" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel Margin="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Runs as" Style="{StaticResource Muted}" Margin="0,0,24,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModeText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Text="Node id" Style="{StaticResource Muted}" Margin="0,0,24,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NodeIdShort}" FontFamily="Consolas" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Text="Host" Style="{StaticResource Muted}" Margin="0,0,24,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                    <Run Text="{Binding HostName, Mode=OneWay}"/><Run Text="  ·  encrypted port " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding PeerPort, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="3" Text="Version" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VersionText}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Traffic between PCs is encrypted." Style="{StaticResource RowHint}" Margin="0"/><TextBlock Style="{StaticResource InfoTip}" ToolTip="Traffic between PCs is encrypted end to end (TLS 1.2/1.3 with certificates on both sides). Each PC's identity is the fingerprint of its own key, so nobody can impersonate it." AutomationProperties.HelpText="Traffic between PCs is encrypted end to end (TLS 1.2/1.3 with certificates on both sides). Each PC's identity is the fingerprint of its own key, so nobody can impersonate it."/></StackPanel>
                            <WrapPanel Margin="-8,10,0,0">
                                <Button Style="{StaticResource BtnGhost}" Content="Copy node id" Command="{Binding CopyNodeIdCommand}"/>
                                <Button Style="{StaticResource BtnGhost}" Content="Open data folder" Command="{Binding OpenDataDirCommand}"/>
                                <Button Style="{StaticResource BtnGhost}" Content="Open logs" Command="{Binding OpenLogsCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Unsaved-changes bar: appears only when something changed -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,20" Padding="18,10,10,10" CornerRadius="10"
                Background="{StaticResource Bg3}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                Visibility="{Binding Dirty, Converter={StaticResource BoolToVis}}">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,10,0"/>
                <TextBlock Text="You have unsaved changes" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <Button Content="Discard" Style="{StaticResource BtnGhost}" Command="{Binding DiscardCommand}"/>
                <Button Content="Save changes" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

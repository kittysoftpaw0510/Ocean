<Window x:Class="Ocean.App.Views.ScreenViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ocean.App.Views"
        Title="Screen" Width="960" Height="620" MinWidth="360" MinHeight="260" WindowStartupLocation="CenterScreen"
        Background="Black" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}">
    <!-- A shared screen (DataContext: ScreenViewVm). View only: nothing typed or clicked here reaches the other PC. -->
    <DockPanel>
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,6,8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- the board: shown or hidden here (a dot with how many new things while hidden) -->
                    <Grid Visibility="{Binding CanPoint, Converter={StaticResource BoolToVis}}" Margin="0,0,2,0">
                        <Button Width="30" Height="28" FontSize="13" Command="{Binding ToggleBoardCommand}" AutomationProperties.Name="The board"
                                ToolTip="Board (B): draw, type and paste together with everybody in this sharing">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                                    <Setter Property="Content" Value="&#xE70F;"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Board.Visible}" Value="True"><Setter Property="Foreground" Value="#5EEAD4"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" MinWidth="15" Height="15" CornerRadius="7.5" Background="#FB7185" Padding="3,0" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers><DataTrigger Binding="{Binding Board.Unseen}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                            <TextBlock Text="{Binding Board.UnseenText}" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource UiFont}"/>
                                </Border>
                    </Grid>
                    <!-- the host's sound here: on, off (M), or not shared at all -->
                    <Button Width="30" Height="28" FontSize="13" Command="{Binding ToggleMuteCommand}" ToolTip="{Binding SoundTip}" AutomationProperties.Name="Sound on or off">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                                <Setter Property="Content" Value="&#xE767;"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                        <Setter Property="Content" Value="&#xE74F;"/>
                                        <Setter Property="Foreground" Value="#FB7185"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Sound}" Value="False">
                                        <Setter Property="Content" Value="&#xE74F;"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" Width="30" Height="28" FontSize="13" Content="&#xE740;" Click="Full_Click" ToolTip="Full screen (F11, double-click; Esc to leave)" AutomationProperties.Name="Full screen"/>
                </StackPanel>
                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FB7185"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPicture}" Value="False"><Setter Property="Fill" Value="{StaticResource Warn}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Ended}" Value="True"><Setter Property="Fill" Value="{StaticResource TextDim}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusTip}">
                    <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding WindowTitle, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/><Run Text="   "/><Run Text="{Binding ViewersText, Mode=OneWay}" Foreground="{StaticResource TextDim}"/>
                </TextBlock>
            </DockPanel>
        </Border>
        <Grid>
            <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
            <!-- where I pointed: a quick ring (the host sees it on their screen) -->
            <Canvas x:Name="Points" IsHitTestVisible="False"/>
            <!-- the board, over the picture's right side; its left edge resizes it -->
            <Grid x:Name="BoardDock" HorizontalAlignment="Right" Margin="0,10,10,10" Visibility="Collapsed" Width="380">
                <local:BoardView x:Name="Board"/>
                <Thumb x:Name="BoardResize" HorizontalAlignment="Left" Width="8" Margin="-4,0,0,0" Cursor="SizeWE" Opacity="0" ToolTip="Drag to make the board wider or narrower"/>
            </Grid>
            <!-- before the first picture -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasPicture, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                <TextBlock Text="Connecting to the shared screen…" Style="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <!-- pictures stopped coming -->
            <Border x:Name="Stalled" Visibility="Collapsed" Background="#CC0A1120" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
                <TextBlock Text="No new picture for a moment: reconnecting…" Foreground="White"/>
            </Border>
            <!-- the host stopped -->
            <Border Background="#D90A1120" Visibility="{Binding Ended, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="The sharing is over. This was the last picture." Style="{StaticResource Muted}" Margin="0,6,0,14" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="Close" Click="Close_Click" HorizontalAlignment="Center" MinWidth="90"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

<UserControl x:Class="Ocean.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000" Focusable="True">
    <Grid x:Name="Root">
        <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                      MediaOpened="Media_MediaOpened" MediaEnded="Media_MediaEnded" MediaFailed="Media_MediaFailed" BufferingStarted="Media_BufferingStarted" BufferingEnded="Media_BufferingEnded"
                      MouseLeftButtonDown="Media_MouseLeftButtonDown"/>

        <!-- error -->
        <Border Background="{StaticResource Overlay}" Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="36" Foreground="{StaticResource Warn}"/>
                <TextBlock Text="This video can't be played in the built-in player" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,6" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="The built-in player relies on the codecs installed in Windows. VLC (or your default player) can play almost anything — streaming stays the same." Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Style="{StaticResource BtnPrimary}" Content="Open in external player" Command="{Binding OpenExternalCommand}"/>
                    <Button Content="Download instead" Margin="8,0,0,0" Command="{Binding DownloadCommand}"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Close" Margin="8,0,0,0" Command="{Binding CloseCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- speed indicator (briefly shown when the speed changes) -->
        <Border x:Name="SpeedOsd" Background="#B3000000" CornerRadius="10" Padding="18,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SpeedOsdText" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- buffering -->
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}"/>

        <!-- top bar -->
        <Border x:Name="TopBar" VerticalAlignment="Top" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E6000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnIcon}" Content="&#xE896;" ToolTip="Download" Command="{Binding DownloadCommand}"/>
                    <Button Style="{StaticResource BtnIcon}" Content="&#xE8A7;" ToolTip="Open in external player" Command="{Binding OpenExternalCommand}"/>
                    <Button Style="{StaticResource BtnIcon}" Content="&#xE711;" ToolTip="Close (Esc)" Command="{Binding CloseCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- bottom controls -->
        <Border x:Name="BottomBar" VerticalAlignment="Bottom" Padding="20,10,20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#E6000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <!-- seek bar with A-B repeat markers -->
                <Grid x:Name="SeekHost" SizeChanged="SeekHost_SizeChanged" Margin="0,12,0,0">
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="LoopBand" Height="6" Canvas.Top="7" RadiusX="3" RadiusY="3" Fill="#663B82F6" Visibility="Collapsed"/>
                    </Canvas>
                    <Slider x:Name="Seek" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" PreviewMouseLeftButtonUp="Seek_MouseUp" IsMoveToPointEnabled="True"/>
                    <Canvas IsHitTestVisible="False">
                        <StackPanel x:Name="MarkA" Visibility="Collapsed">
                            <TextBlock Text="A" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/>
                            <Rectangle Width="2" Height="14" Fill="{StaticResource Warn}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="MarkB" Visibility="Collapsed">
                            <TextBlock Text="B" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/>
                            <Rectangle Width="2" Height="14" Fill="{StaticResource Warn}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Canvas>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnIcon}" Width="40" Height="36" FontSize="18" Click="PlayPause_Click" ToolTip="Play / pause (Space)">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE768;"/>
                                        <Setter Property="FontSize" Value="18"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Text" Value="&#xE769;"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Content="&#xEB9E;" ToolTip="Back 10 s (←)" Click="Back_Click"/>
                        <Button Style="{StaticResource BtnIcon}" Content="&#xEB9D;" ToolTip="Forward 10 s (→)" Click="Fwd_Click"/>
                        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Consolas" FontSize="13"/>
                        <!-- A-B repeat: set A, set B (loop), clear -->
                        <Button x:Name="LoopButton" Click="Loop_Click" Margin="14,0,0,0" Padding="10,4" AutomationProperties.Name="A-B repeat"
                                ToolTip="A-B repeat: click to set A, again to set B and loop, again to stop.  Keys: [ set A,  ] set B,  \ clear">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoopArmed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoopActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EE;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="{Binding LoopText}" FontFamily="Consolas" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- playback speed -->
                        <Button x:Name="SpeedButton" Style="{StaticResource BtnGhost}" Padding="10,4" Margin="0,0,8,0" Click="Speed_Click"
                                ToolTip="Playback speed (Shift+&gt; faster, Shift+&lt; slower)" AutomationProperties.Name="Playback speed">
                            <TextBlock Text="{Binding SpeedText}" FontFamily="Consolas" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Command="{Binding ToggleMuteCommand}" ToolTip="Mute (M)">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE767;"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Text" Value="&#xE74F;"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Width="100" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <Button Style="{StaticResource BtnIcon}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Fullscreen (F)">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE740;"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsFullscreen}" Value="True"><Setter Property="Text" Value="&#xE73F;"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

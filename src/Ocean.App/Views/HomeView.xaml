<UserControl x:Class="Ocean.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="40">
            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="44" Foreground="{StaticResource Accent}" Margin="0,0,0,18"/>
            <TextBlock Style="{StaticResource H1}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                <Run Text="Welcome, "/><Run Text="{Binding MyName}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14"
                       Text="Pick a node on the left to browse and watch what it shares. Add your own videos under My shares, and everyone on this network will see them."/>

            <!-- Live now: multicasts on the network, one card each -->
            <ItemsControl ItemsSource="{Binding Live}" Margin="0,28,0,0" Visibility="{Binding AnyLive, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8" AutomationProperties.Name="Live now">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Join" Margin="12,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Watch together; the host controls playback"
                                        Command="{Binding DataContext.JoinLiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="#FB7185" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Who}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Dim}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Continue watching: the last video played and where it stopped -->
            <Border Style="{StaticResource Card}" Margin="0,28,0,0" Padding="12" DataContext="{Binding Resume}"
                    Visibility="{Binding Converter={StaticResource NullToVis}}"
                    AutomationProperties.Name="Continue watching">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- thumbnail with the watched part underneath; clicking it resumes too -->
                    <Button Command="{Binding DataContext.ResumeLastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Cursor="Hand" Focusable="False" ToolTip="{Binding ActionText}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="160" Height="90">
                                    <Border CornerRadius="6" Background="{StaticResource Bg3}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource TextDim}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="PlayBadge" Width="40" Height="40" CornerRadius="20" Background="#B0000000"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Border>
                                    <Border Height="4" VerticalAlignment="Bottom" Background="#80000000" CornerRadius="0,0,6,6">
                                        <Border Background="{StaticResource Accent}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PlayBadge" Property="Opacity" Value="1"/>
                                        <Setter TargetName="PlayBadge" Property="Background" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Column="1" Margin="14,2,12,0" VerticalAlignment="Center">
                        <TextBlock Text="CONTINUE WATCHING" Style="{StaticResource Dim}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Data.Name}"/>
                        <TextBlock Text="{Binding Where}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding DataContext.ResumeLastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="{Binding ActionText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="Remove from Continue watching"
                                AutomationProperties.Name="Remove from Continue watching"
                                Command="{Binding DataContext.ForgetLastCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,28,0,0" Visibility="{Binding PeerCount, Converter={StaticResource ZeroToVis}}">
                <StackPanel>
                    <TextBlock Text="No other nodes found yet" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Install Ocean on another PC on the same local network. Nodes find each other automatically within a few seconds."/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding RealmSet, Converter={StaticResource BoolToVis}}"
                               Text="You have set a shared secret: only nodes that entered the same secret are visible to you."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,28,0,0" Visibility="{Binding TotalNew, Converter={StaticResource CountToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Badge}" Margin="0,0,10,0"><TextBlock Text="{Binding TotalNew}" FontWeight="SemiBold" Foreground="#042F2E"/></Border>
                    <TextBlock Text="new videos since your last visits, highlighted in the node list." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

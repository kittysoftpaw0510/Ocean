<Window x:Class="Ocean.App.Views.ScreenBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocean: sharing your screen" SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}" Foreground="White">
    <!-- "You are sharing your screen" (DataContext: ScreenViewModel). Kept out of the capture: viewers don't see it. -->
    <Border Background="#F21A0F14" BorderBrush="#E11D48" BorderThickness="1.5" CornerRadius="9" Padding="12,7,8,7" Margin="6" Cursor="SizeAll" ToolTip="{Binding SharingPeopleTip}">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="#FB7185" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="{Binding SharingTitle}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SharingDetail}" FontSize="12" Foreground="#FBCFD6" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Content="Stop sharing" Click="Stop_Click" Margin="14,0,0,0" Background="#E11D48" BorderBrush="#E11D48" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>

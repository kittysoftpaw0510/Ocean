<UserControl x:Class="Ocean.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Ocean.App.Controls">
    <UserControl.Resources>
        <Style x:Key="NodeChip" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Margin="24,16,24,6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Search" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                       c:Spin.IsSpinning="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- node chips -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="24,4,24,8" Visibility="{Binding Nodes.Count, Converter={StaticResource CountToVis}}">
            <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NodeChip}" Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource TextDim}" Visibility="{Binding Online, Converter={StaticResource InvBoolToVis}}" ToolTip="Offline: its last known list"/>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Count}" Style="{StaticResource Dim}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- results -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Results}" Margin="12,0,12,8" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" Margin="12,2" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="8,6" Cursor="Hand" ToolTip="{Binding Tooltip}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.PlayNetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding DataContext.PlayNetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Cursor="Hand" Focusable="False" ToolTip="Play">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="112" Height="63">
                                            <Border CornerRadius="6" Background="{StaticResource Bg3}" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Item.Thumb}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="PlayBadge" Width="30" Height="30" CornerRadius="15" Background="#B0000000" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PlayBadge" Property="Opacity" Value="1"/>
                                                <Setter TargetName="PlayBadge" Property="Background" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                    <Hyperlink Command="{Binding DataContext.BrowseNetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="{StaticResource TextMuted}" TextDecorations="None" ToolTip="Open this node's list">
                                        <Run Text="{Binding Where, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Dim}" Text="{Binding Details}" Margin="0,2,0,0"/>
                                <ContentPresenter Content="{Binding Item}" ContentTemplate="{StaticResource SocialLine}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource LikeBtn}" Content="&#xE8E1;" ToolTip="{Binding LikeMenu}" Visibility="{Binding CanVote, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.VoteNetUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource DislikeBtn}" Content="&#xE8E0;" ToolTip="{Binding DislikeMenu}" Visibility="{Binding CanVote, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.VoteNetDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE896;" ToolTip="Download" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.DownloadNetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE768;" ToolTip="Play"
                                        Command="{Binding DataContext.PlayNetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Bg2}"/></Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- empty -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="36" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

<Window x:Class="Ocean.App.Views.ScreenWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocean: waiting for an answer" Width="400" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <!-- My screen request, waiting for the other PC's answer (DataContext: ScreenWaitVm). Ocean's main window can't be
         used meanwhile (no second request); it closes by itself as soon as they answer, or with Cancel. -->
    <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="10" Padding="18,16,18,14" Margin="8">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/></Border.Effect>
        <StackPanel>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{Binding PeerId, Converter={StaticResource InitialsBrush}}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="15" Foreground="#0A1120" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding What}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="Cancel request" Click="Cancel_Click" IsCancel="True" MinWidth="110"
                        ToolTip="Take the request back: it disappears from their screen at once (Esc)"/>
                <!-- three dots that breathe one after another, and how long it has been -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Elapsed}" Style="{StaticResource Dim}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="Ocean.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocean" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
        <PasswordBox x:Name="Box" KeyDown="Box_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource BtnGhost}" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Unlock" Style="{StaticResource BtnPrimary}" Click="Ok_Click" Margin="8,0,0,0" IsDefault="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>

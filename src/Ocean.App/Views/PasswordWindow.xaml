<Window x:Class="Ocean.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocean" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
        <PasswordBox x:Name="Box" KeyDown="Box_KeyDown" AutomationProperties.Name="Password"/>
        <!-- setting a new password: typed twice, so a typo can't lock the video with a password nobody knows -->
        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="Type it again" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmBox" KeyDown="ConfirmBox_KeyDown" AutomationProperties.Name="Type the password again"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource BtnGhost}" Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Unlock" Style="{StaticResource BtnPrimary}" Click="Ok_Click" Margin="8,0,0,0" IsDefault="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>

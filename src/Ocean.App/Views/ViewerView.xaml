<UserControl x:Class="Ocean.App.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F00A0F1A" Focusable="True" FocusVisualStyle="{x:Null}">
    <!-- the built-in viewer (DataContext: ViewerViewModel): a picture (fit, zoom, ←/→) or a PDF's pages -->
    <UserControl.Resources>
        <Style x:Key="BarBtn" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#C8D2E0"/>
        </Style>
        <!-- a big round arrow at a side of the picture -->
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="46" Height="46" CornerRadius="23" Background="#80101826" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontFamily="Segoe MDL2 Assets" TextElement.FontSize="16"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CC1E293B"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Hidden"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- the bar: what it is, where it comes from, zoom, download, close -->
        <Border DockPanel.Dock="Top" Background="#E60F1626" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1" Padding="16,8,10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageText}" Foreground="#93A3B8" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding PageText, Converter={StaticResource NullToVis}}"/>
                    <TextBlock Text="{Binding Position}" Foreground="#93A3B8" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource BarBtn}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Smaller (−, Ctrl+wheel)" AutomationProperties.Name="Zoom out"/>
                    <Button x:Name="ZoomText" Click="Fit_Click" MinWidth="52" Height="32" Cursor="Hand" Foreground="#C8D2E0" FontSize="12" Background="Transparent" BorderThickness="0"
                            ToolTip="Fit to the window (0)" AutomationProperties.Name="Fit to the window">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Style="{StaticResource BarBtn}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Larger (+, Ctrl+wheel)" AutomationProperties.Name="Zoom in"/>
                    <Border Width="1" Height="18" Background="#26FFFFFF" Margin="6,0"/>
                    <Button Style="{StaticResource BarBtn}" Content="&#xE896;" Command="{Binding DownloadCommand}" ToolTip="Download" AutomationProperties.Name="Download"
                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource BarBtn}" Content="&#xE8BB;" FontSize="12" Command="{Binding CloseCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="KindGlyph" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#5EEAD4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="#E8EEF8" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#93A3B8" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <!-- a picture: its preview at once, the picture itself when it is here; zoomed and moved by hand -->
            <Grid x:Name="ImageArea" Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" ClipToBounds="True">
                <Image Source="{Binding Preview}" Stretch="Uniform" Margin="24" Opacity="0.55" RenderOptions.BitmapScalingMode="LowQuality"
                       Visibility="{Binding Image, Converter={StaticResource NullToVisInv}}"/>
                <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Image x:Name="Picture" Source="{Binding Image}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand">
                        <Image.LayoutTransform><ScaleTransform x:Name="PictureZoom"/></Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
                <Button Style="{StaticResource SideBtn}" Content="&#xE76B;" HorizontalAlignment="Left" Margin="18,0,0,0" Command="{Binding PreviousCommand}"
                        ToolTip="Previous picture (←)" AutomationProperties.Name="Previous picture" Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}" x:Name="PrevButton"/>
                <Button Style="{StaticResource SideBtn}" Content="&#xE76C;" HorizontalAlignment="Right" Margin="0,0,18,0" Command="{Binding NextCommand}"
                        ToolTip="Next picture (→)" AutomationProperties.Name="Next picture" Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}" x:Name="NextButton"/>
            </Grid>
            <!-- a PDF: every page, drawn when it comes into view, at the size it is shown -->
            <ScrollViewer x:Name="PdfScroll" Visibility="{Binding IsPdf, Converter={StaticResource BoolToVis}}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="Pages" HorizontalAlignment="Center" Margin="0,16,0,24"/>
            </ScrollViewer>
            <!-- loading, or why it can't be shown -->
            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <Border Background="#E60F1626" CornerRadius="10" Padding="22,16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource Warn}"/>
                    <TextBlock Text="{Binding Error}" Foreground="#E8EEF8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Content="Download" Command="{Binding DownloadCommand}" Margin="0,0,8,0" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Close" Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

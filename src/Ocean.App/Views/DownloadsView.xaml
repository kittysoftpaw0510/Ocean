<UserControl x:Class="Ocean.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,10">
            <StackPanel>
                <TextBlock Text="Downloads" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnGhost}" Content="Clear finished" Command="{Binding ClearCompletedCommand}" Margin="0,0,6,0"/>
                <Button Command="{Binding OpenDownloadsFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="Open folder"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}" Margin="12,0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="12,3" CornerRadius="10" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Foreground" Value="{StaticResource New}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0">
                                    <Run Text="from "/><Run Text="{Binding PeerName, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding RelPath, Mode=OneWay}"/>
                                </TextBlock>
                                <Grid Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource EqualsToVis}, ConverterParameter=Running}">
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6"/>
                                </Grid>
                                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE768;" ToolTip="Open" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE8DA;" ToolTip="Show in folder" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE72C;" ToolTip="Retry" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE711;" ToolTip="Cancel" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE74D;" ToolTip="Remove from list" Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="36" Foreground="{StaticResource TextDim}"/>
            <TextBlock Text="No downloads yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
            <TextBlock Text="Right-click any video on a node, or use “Download all” on a share." Style="{StaticResource Muted}"/>
        </StackPanel>
    </Grid>
</UserControl>

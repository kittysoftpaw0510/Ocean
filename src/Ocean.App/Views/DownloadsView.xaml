<UserControl x:Class="Ocean.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,10">
            <StackPanel>
                <TextBlock Text="Downloads" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnGhost}" Content="Clear finished" Command="{Binding ClearCompletedCommand}" Margin="0,0,6,0"/>
                <Button Command="{Binding OpenDownloadsFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="Open folder"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- what others download from me right now: which file, to whom, how far; one can be let go at full speed -->
        <StackPanel Grid.Row="1" Margin="24,0,24,10" Visibility="{Binding Sending.Count, Converter={StaticResource CountToVis}}">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="SENDING TO OTHERS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SendingSummary}" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer MaxHeight="232" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sending}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" CornerRadius="10" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Run Text="to "/><Run Text="{Binding Who, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Foreground="{StaticResource Text}">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding ShareName, Mode=OneWay}" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Active}" Value="False"><Setter Property="Opacity" Value="0.4"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border CornerRadius="4" Padding="5,0,6,1" Margin="0,0,8,0" Background="#2614B8A6" VerticalAlignment="Center"
                                                    Visibility="{Binding FullSpeed, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="9" Foreground="{StaticResource Accent}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Full speed" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- full speed: on (lit) / off -->
                                    <Button Grid.Column="1" Content="&#xE945;" ToolTip="{Binding FullSpeedTip}" AutomationProperties.Name="Full speed" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleFullSpeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BtnIcon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FullSpeed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        <Setter Property="Background" Value="#2614B8A6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="MY DOWNLOADS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,14,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}"/>
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Jobs}" Margin="12,0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="12,3" CornerRadius="10" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Foreground" Value="{StaticResource New}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0">
                                    <Run Text="from "/><Run Text="{Binding PeerName, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding RelPath, Mode=OneWay}"/>
                                </TextBlock>
                                <Grid Margin="0,6,0,0" Visibility="{Binding ShowBar, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </Grid>
                                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE768;" ToolTip="Open" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE8DA;" ToolTip="Show in folder" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE769;" ToolTip="Pause (what came so far is kept)" AutomationProperties.Name="Pause" Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE768;" ToolTip="Resume from where it stopped" AutomationProperties.Name="Resume" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"
                                        Foreground="{StaticResource Accent}"
                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE72C;" ToolTip="Retry" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE711;" ToolTip="Cancel" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BtnIcon}" Content="&#xE74D;" ToolTip="Remove from list" Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="36" Foreground="{StaticResource TextDim}"/>
            <TextBlock Text="No downloads yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
            <TextBlock Text="Right-click any file on a node, or use “Download all” on a share." Style="{StaticResource Muted}"/>
        </StackPanel>
    </Grid>
</UserControl>

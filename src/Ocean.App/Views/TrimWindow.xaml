<Window x:Class="Ocean.App.Views.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trim" Width="920" Height="640" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}">
    <!-- Cut off the start and the end of a recording; the original stays as it is. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource BtnPrimary}" Content="Save trimmed copy" Click="Save_Click" MinWidth="140"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Hint" Style="{StaticResource Dim}" TextWrapping="Wrap"
                               Text="A new file is saved next to it; the original stays as it is. Cutting only the end is instant."/>
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,6,12,0" Maximum="1" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- marks -->
        <Border DockPanel.Dock="Bottom" Padding="16,4,16,10">
            <DockPanel>
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Width="34" Height="30" FontSize="13" Content="&#xE768;" Foreground="{StaticResource Text}" Click="Play_Click" ToolTip="Play / pause (Space)"/>
                <TextBlock x:Name="TimeText" DockPanel.Dock="Left" FontFamily="Consolas" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="8,0,16,0" MinWidth="140"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="SetStart_Click" Margin="0,0,6,0" Padding="12,5" Content="Set start" ToolTip="The trimmed copy starts at the playhead (I)"/>
                    <Button Click="SetEnd_Click" Padding="12,5" Content="Set end" ToolTip="The trimmed copy ends at the playhead (O)"/>
                </StackPanel>
                <TextBlock x:Name="RangeText" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- the timeline: the cut-off parts stay dim, the kept part is a solid band between two handles; the
             playhead is a white knob (the slider draws nothing else, so the band is never covered) -->
        <Grid DockPanel.Dock="Bottom" Margin="16,10,16,4" Height="34">
            <Border Height="6" CornerRadius="3" Background="#24FFFFFF" VerticalAlignment="Center" Margin="7,0"/>
            <Canvas x:Name="Band" Margin="7,0" IsHitTestVisible="False">
                <Border x:Name="Kept" Height="10" CornerRadius="2" Canvas.Top="12" Background="{StaticResource Accent}"/>
                <Border x:Name="StartMark" Width="4" Height="26" CornerRadius="2" Canvas.Top="4" Background="White"/>
                <Border x:Name="EndMark" Width="4" Height="26" CornerRadius="2" Canvas.Top="4" Background="White"/>
            </Canvas>
            <Slider x:Name="Timeline" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True" Height="34"
                    ValueChanged="Timeline_ValueChanged" PreviewMouseLeftButtonDown="Timeline_Down" PreviewMouseLeftButtonUp="Timeline_Up">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="34" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border Width="2" Background="White" Opacity="0.85" HorizontalAlignment="Center"/>
                                                <Ellipse Width="14" Height="14" Fill="White" Stroke="{StaticResource Bg1}" StrokeThickness="2" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>
        </Grid>

        <Grid Background="Black">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"
                          MediaOpened="Player_Opened" MediaEnded="Player_Ended" MediaFailed="Player_Failed"/>
            <TextBlock x:Name="Problem" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" Margin="24"/>
        </Grid>
    </DockPanel>
</Window>

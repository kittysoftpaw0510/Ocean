<Window x:Class="Ocean.App.Views.ScreenPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share your screen" Width="760" Height="640" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="True">
    <!-- What to share: a whole screen, a part of one, or one window. Nothing is shared before "Share" is pressed. -->
    <Window.Resources>
        <Style x:Key="SourceItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="2" CornerRadius="8" Padding="6" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SourceCard">
            <StackPanel Width="196" ToolTip="{Binding Name}">
                <Border Height="110" Background="#0A1120" CornerRadius="5" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Preview}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,6,2,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="2,0,2,2" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,6">
            <TextBlock x:Name="Heading" Style="{StaticResource H1}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Detail" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="ShareButton" Style="{StaticResource BtnPrimary}" Content="Share" IsDefault="True" IsEnabled="False" Click="Share_Click" MinWidth="90"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <!-- recording: quality, sound, where it goes (DataContext: RecordViewModel, set in code) -->
                    <StackPanel x:Name="RecordOptions" Visibility="Collapsed" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Quality" Style="{StaticResource Muted}" VerticalAlignment="Center" Width="62"/>
                            <RadioButton GroupName="RecQuality" Content="Small file" IsChecked="{Binding IsSmall}" Margin="0,0,16,0" ToolTip="{Binding Qualities[0].Hint}"/>
                            <RadioButton GroupName="RecQuality" Content="Balanced" IsChecked="{Binding IsBalanced}" Margin="0,0,16,0" ToolTip="{Binding Qualities[1].Hint}"/>
                            <RadioButton GroupName="RecQuality" Content="High" IsChecked="{Binding IsHigh}" ToolTip="{Binding Qualities[2].Hint}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding QualityHint}" Style="{StaticResource Dim}" Margin="62,3,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Sound" Style="{StaticResource Muted}" VerticalAlignment="Center" Width="62"/>
                            <!-- (the Switch style shows On/Off, not its content: the labels are beside them) -->
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Speaker}" AutomationProperties.Name="Record the speaker sound"/>
                            <TextBlock Text="Speaker" Margin="8,0,20,0" VerticalAlignment="Center" ToolTip="What your PC plays: videos, calls, games"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Mic}" IsEnabled="{Binding MicAvailable}" AutomationProperties.Name="Record the microphone"/>
                            <TextBlock Text="{Binding MicText}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Your voice (the default microphone). It can be muted while recording."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Start" Style="{StaticResource Muted}" VerticalAlignment="Center" Width="62"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Countdown}" AutomationProperties.Name="Count down 3, 2, 1 first"/>
                            <TextBlock Text="Count down 3, 2, 1 first" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="A moment to get ready, so the video doesn't open on the Start click (Esc or a click cancels)"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}">
                            <Run Text="Saved in "/><Run Text="{Binding Folder, Mode=OneWay}"/><Run Text="  (Settings › Screen recordings)"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="ShareOptions" Orientation="Horizontal" ToolTip="30 pictures a second instead of 15: for video and animation. Uses about twice the network and processor; for documents, code and slides it makes no visible difference.">
                        <!-- (the Switch style shows On/Off, not its content: the label is beside it) -->
                        <CheckBox x:Name="Smooth" Style="{StaticResource Switch}" AutomationProperties.Name="Smooth motion"/>
                        <TextBlock Text="Smooth motion (30 fps)" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                   MouseLeftButtonUp="SmoothLabel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="Chosen" Style="{StaticResource Dim}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- (the theme's ScrollViewer ignores Padding: the gap is the content's margin) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,6,10,6">
                <DockPanel Margin="0,8,0,8">
                    <Button DockPanel.Dock="Right" Click="Region_Click" ToolTip="Mark a rectangle on the selected screen with the mouse; only that part is shared" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEF20;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Share only a part of a screen…"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="SCREENS" Style="{StaticResource Dim}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="Screens" ItemContainerStyle="{StaticResource SourceItem}" ItemTemplate="{StaticResource SourceCard}" ItemsPanel="{StaticResource Wrap}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Source_SelectionChanged" MouseDoubleClick="Source_DoubleClick"/>

                <TextBlock Text="WINDOWS" Style="{StaticResource Dim}" FontWeight="SemiBold" Margin="0,10,0,8"/>
                <ListBox x:Name="Windows" ItemContainerStyle="{StaticResource SourceItem}" ItemTemplate="{StaticResource SourceCard}" ItemsPanel="{StaticResource Wrap}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Source_SelectionChanged" MouseDoubleClick="Source_DoubleClick"/>
                <TextBlock x:Name="NoWindows" Text="No open windows to share (minimized windows can't be captured: restore one first)." Style="{StaticResource Dim}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Text="A shared window shows only that window, also when other windows cover it. A minimized window can't be shared." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="Ocean.App.Views.ScreenPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share your screen" Width="760" Height="640" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" ShowInTaskbar="True">
    <!-- What to share: a whole screen, a part of one, or one window. Nothing is shared before "Share" is pressed. -->
    <Window.Resources>
        <Style x:Key="SourceItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="2" CornerRadius="8" Padding="6" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SourceCard">
            <StackPanel Width="196" ToolTip="{Binding Name}">
                <Border Height="110" Background="#0A1120" CornerRadius="5" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Preview}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,6,2,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" Margin="2,0,2,2" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,6">
            <TextBlock x:Name="Heading" Style="{StaticResource H1}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Detail" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="ShareButton" Style="{StaticResource BtnPrimary}" Content="Share" IsDefault="True" IsEnabled="False" Click="Share_Click" MinWidth="90"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <CheckBox x:Name="Smooth" Style="{StaticResource Switch}" Content="Smooth motion"
                              ToolTip="30 pictures a second instead of 15: for video and animation. Uses about twice the network and processor; for documents, code and slides it makes no visible difference."/>
                    <TextBlock x:Name="Chosen" Style="{StaticResource Dim}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,6,10,6">
            <StackPanel>
                <DockPanel Margin="0,8,0,8">
                    <Button DockPanel.Dock="Right" Click="Region_Click" ToolTip="Mark a rectangle on the selected screen with the mouse; only that part is shared" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEF20;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Share only a part of a screen…"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="SCREENS" Style="{StaticResource Dim}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="Screens" ItemContainerStyle="{StaticResource SourceItem}" ItemTemplate="{StaticResource SourceCard}" ItemsPanel="{StaticResource Wrap}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Source_SelectionChanged" MouseDoubleClick="Source_DoubleClick"/>

                <TextBlock Text="WINDOWS" Style="{StaticResource Dim}" FontWeight="SemiBold" Margin="0,10,0,8"/>
                <ListBox x:Name="Windows" ItemContainerStyle="{StaticResource SourceItem}" ItemTemplate="{StaticResource SourceCard}" ItemsPanel="{StaticResource Wrap}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Source_SelectionChanged" MouseDoubleClick="Source_DoubleClick"/>
                <TextBlock x:Name="NoWindows" Text="No open windows to share (minimized windows can't be captured: restore one first)." Style="{StaticResource Dim}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Text="A shared window shows only that window, also when other windows cover it. A minimized window can't be shared." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
